/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://api.paystack.co; frame-src 'self' https://checkout.paystack.com; form-action 'self' https://checkout.paystack.com; worker-src 'self' blob:; base-uri 'self'; object-src 'none'

/sw.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: max-age=3600

/runtime-config.js
  Cache-Control: no-store, no-cache, must-revalidate

/auth.js
  Cache-Control: no-store, no-cache, must-revalidate

/app.js
  Cache-Control: no-store, no-cache, must-revalidate

/*.js
  Cache-Control: max-age=31536000, immutable

/*.css
  Cache-Control: max-age=31536000, immutable
